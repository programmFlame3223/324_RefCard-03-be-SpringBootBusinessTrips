{
  "family": "biztrips-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::996351687157:role/LabRole",
  "containerDefinitions": [
    {
      "name": "biztrips-backend",
      "image": "996351687157.dkr.ecr.eu-central-1.amazonaws.com/biztrips-backend:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "mariadb" },
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:mariadb://biztrips-backend-db.cnwddlr9pfld.us-east-1.rds.amazonaws.com:3306/db_biztrips" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "admin" }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:996351687157:secret:biztrips-backend-db-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/biztrips-backend",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}